{
    "definition": ["WITH_NODEJS"],
    "include": [
        "/include",
        "/deps/v8/include",
        "/deps/uv/include"
    ],
    "skip": { 
        "win": { "ia32": true }
    },
    "link-libraries": {
        "win": {
            "ia32": ["/Lib/Win32/libnode.lib"],
            "x64": ["/Lib/Win64/libnode.lib"]
        },
        "linux": {
            "x64": ["/lib/Linux/libnode.so.108"]
        }
    },
    "copy-libraries": {
        "win": {
            "ia32": ["/lib/Win32/libnode.dll"],
            "x64": ["/lib/Win64/libnode.dll"]
        },
        "linux": {
            "x64": ["/lib/Linux/libnode.so.108"]
        }
    }
}
