diff --git a/deps/uv/src/unix/core.c b/deps/uv/src/unix/core.c
index 73027cb..842cdef 100644
--- a/deps/uv/src/unix/core.c
+++ b/deps/uv/src/unix/core.c
@@ -974,8 +974,11 @@ int uv__io_start(uv_loop_t* loop, uv__io_t* w, unsigned int events) {
     return 0;
 #endif
 
