diff --git a/deps/uv/include/uv.h b/deps/uv/include/uv.h
index da06345..62146b2 100644
--- a/deps/uv/include/uv.h
+++ b/deps/uv/include/uv.h
@@ -1941,6 +1941,8 @@ union uv_any_req {
 struct uv_loop_s {
   /* User data - use this for whatever. */
   void* data;
